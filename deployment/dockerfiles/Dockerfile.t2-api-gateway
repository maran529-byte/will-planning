# Build stage
FROM golang:1.21-alpine AS builder

WORKDIR /app

RUN apk add --no-cache git ca-certificates

COPY go.mod go.sum* ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -o /server ./cmd

# Final stage
FROM alpine:3.19

RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app

COPY --from=builder /server .

ENV GIN_MODE=release
ENV GW_HOST=0.0.0.0
ENV GW_PORT=8080
ENV RATE_LIMIT_ENABLED=true
ENV RATE_LIMIT_REQUESTS_PER_SEC=100
ENV RATE_LIMIT_BURST_SIZE=200
ENV CIRCUIT_ENABLED=true
ENV CIRCUIT_THRESHOLD=5
ENV CIRCUIT_TIMEOUT=30
ENV GRAY_ENABLED=true
ENV GRAY_PERCENT=10

EXPOSE 8080

CMD ["./server"]