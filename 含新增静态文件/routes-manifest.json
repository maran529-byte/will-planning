    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/guide",
      "destination": "/knowledge",
      "statusCode": 308,
      "regex": "^(?!/_next)/guide(?:/)?$"
    },
    {
      "source": "/guide/pre-marriage",
