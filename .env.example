# ============================================================================
# aiwill-planner · 环境变量样例 (2026-06-19)
# 复制: cp .env.example .env.local
# Vercel: 在 Vercel Dashboard → Project → Settings → Environment Variables 配置
# 大陆: 写入 /opt/aiwill-app/.env (PM2 启动时会自动加载)
#
# ⚠️ 必填: SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY
# ⚠️ 支付 P0: WECHAT_MP_API_V3_KEY + WECHAT_PAY_PLAT_CERT (无这俩, 支付路由返 503)
# ============================================================================

# --- 基础 ---
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://aiwill-planner.cn
NEXT_PUBLIC_H5_SITE_URL=https://h5.aiwill-planner.cn

# --- Supabase (P0 必填) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- 微信支付 V3 (P0: 未配则支付路由 503) ---
# 32 字节 APIv3 密钥 (微信商户平台 → API 安全)
WECHAT_MP_API_V3_KEY=
# 微信平台证书公钥 (从 /v3/certificates 接口下载, PEM 格式)
WECHAT_PAY_PLAT_CERT=
# 商户号
WECHAT_MCHID=
# 公众号 AppID
WECHAT_APPID=
# 公众号 AppSecret
WECHAT_APPSECRET=
# 回调地址 (HTTPS, 微信要求 80/443 之外端口, Vercel Edge 走 443 OK)
WECHAT_PAY_NOTIFY_URL=https://aiwill-planner.cn/api/payment/callback

# --- 微信公众号 (OAuth + JSSDK) ---
# 公众号 AppID (OAuth 登录 + JSSDK 用; 兼容 WECHAT_APPID 旧名)
WECHAT_MP_APP_ID=
# 公众号 AppSecret (⚠️ P0: 不配置 → 微信登录失败 41004 appsecret missing)
# 兼容旧名 WECHAT_APPSECRET
WECHAT_MP_APP_SECRET=
# 公众号原始 ID (gh_xxxx 形式)
WECHAT_MP_ID=
# 公众号 Token (服务器配置)
WECHAT_MP_TOKEN=
# 公众号 EncodingAESKey
WECHAT_MP_AES_KEY=

# --- 虎皮椒支付 (manual/hupijiao 通道) ---
HUPIJIAO_APPID=
HUPIJIAO_SECRET=
HUPIJIAO_NOTIFY_URL=https://aiwill-planner.cn/api/payment/hupijiao-callback

# --- Stripe (海外卡) ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# --- 阿里云 OSS (PDF/Word 下载签名 URL) ---
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=aiwill-planner
ALIYUN_OSS_REGION=oss-cn-shanghai

# --- LLM (当前已 kill switch, 仅留作日后备案后恢复) ---
# 合规 P0: 暂未取得生成式 AI 服务备案, 当前强制走模板 fallback
# 备案完成后, 解除 src/app/api/generate-will/route.ts 的 AI_SERVICE_COMPLIANCE_KILLED
LLM_API_KEY=
LLM_BASE_URL=https://api.minimax.chat/anthropic
LLM_MODEL=MiniMax-M2.7

# --- 合规密钥 (PIPL §51 要求 PII 字段加密) ---
ID_CARD_ENCRYPTION_KEY=

# --- 监控 ---
SENTRY_DSN=
FEISHU_WEBHOOK_URL=
