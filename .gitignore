# ============================================================
# AI Will Planner — .gitignore
# Merged: HEAD (deployment) + origin/main (Next.js)
# ============================================================

# ---- Next.js (origin/main) ----
# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ---- HEAD (deployment infra) ----
.turbo/
dist/
*.tsbuildinfo

# Env / secrets
.env
.env.local
.env.*.local
secrets/
.gh-token
.token

# Logs
*.log
logs/
.deploy-logs/

# OS
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath

# Backups / temp
*.bak
*.bak.*
*.tmp
*.orig
*.rej
*~

# Docker / K8s
docker-compose.override.yml

# Test / coverage
.nyc_output/
playwright-report/
test-results/
*.lcov

# Python (tooling)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
.envrc

# Misc
.history/
.tmp/
.cache/
