# ============================================================
# AI Will Planner - 香港云服务器部署环境变量
# ============================================================
# 注意：所有 AI 生成算力在境外（OpenAI/Claude API）
# 所有数据存储在境外 PostgreSQL/MySQL
# 支付使用 Stripe/PayPal（境外）
# ============================================================

# --------- 数据库配置 (PostgreSQL for most services) ---------
DB_HOST=localhost
DB_PORT=5432
DB_USER=aiwill
DB_PASSWORD=your-postgres-password
DB_NAME=aiwill_prod
DB_SSLMODE=disable

# --------- MySQL (for t5-membership, t6-affiliate) ---------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=your-mysql-password
MYSQL_DATABASE=membership

# --------- JWT 配置 ---------
JWT_SECRET=your-jwt-secret-key-min-32-chars-production
JWT_ISSUER=aiwill-planner
JWT_AUDIENCE=aiwill-api

# --------- 合规引擎 (t1-compliance-engine) ---------
COMPLIANCE_RULES_PATH=/rules
COMPLIANCE_HOT_RELOAD=true
AUDIT_LOG_PATH=/logs

# --------- 契约生成 (t4-contract-generator) ---------
GENERATOR_TEMPLATES_PATH=/templates
OUTPUT_PATH=/output
GENERATOR_MAX_RETRIES=3

# --------- 文档渲染 (t7-document-renderer) ---------
RENDERER_TEMPLATES_PATH=/templates
RENDERER_OUTPUT_PATH=/output
RENDERER_MAX_RETRIES=3

# --------- 会员系统 (t5-membership) ---------
# 使用 Stripe 进行境外支付
STRIPE_KEY=sk_live_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
MEMBERSHIP_DB_DSN=root:your-mysql-password@tcp(mysql:3306)/membership?charset=utf8mb4&parseTime=True&loc=Local

# --------- 联盟系统 (t6-affiliate) ---------
AFFILIATE_DB_HOST=mysql
AFFILIATE_DB_PORT=3306
AFFILIATE_DB_USER=root
AFFILIATE_DB_PASSWORD=your-mysql-password
AFFILIATE_DB_NAME=affiliate
APP_COMMISSION_RULE_LEVEL1=0.1
APP_COMMISSION_RULE_LEVEL2=0.05
APP_WITHDRAW_MIN_AMOUNT=100
APP_WITHDRAW_FEE_RATE=0.01

# --------- AI 提供商配置 (境外) ---------
# OpenAI API (美国)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Anthropic Claude API (美国)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_API_BASE=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# AI 模型选择: openai 或 anthropic
AI_PROVIDER=openai

# --------- Nginx ---------
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# --------- API 网关 ---------
GW_HOST=0.0.0.0
GW_PORT=8080
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_SEC=100
RATE_LIMIT_BURST_SIZE=200
CIRCUIT_ENABLED=true
CIRCUIT_THRESHOLD=5
CIRCUIT_TIMEOUT=30

# --------- 灰度发布 ---------
GRAY_ENABLED=true
GRAY_PERCENT=10

# --------- 健康检查 ---------
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=5s